rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active == true; }
    function sameOrg(orgId) { return active() && profile().orgId == orgId; }
    function roleIs(roles) { return active() && profile().role in roles; }
    function serviceIs(services) { return active() && profile().service in services; }
    function admin() { return roleIs(['owner', 'admin']); }

    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow read: if sameOrg(orgId);
      allow update: if sameOrg(orgId) && admin();
      allow delete: if sameOrg(orgId) && roleIs(['owner']);

      match /citizens/{id} {
        allow read: if sameOrg(orgId);
        allow write: if sameOrg(orgId) && (admin() || roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']));
      }
      match /vehicles/{id} {
        allow read: if sameOrg(orgId) && (admin() || serviceIs(['GN', 'PN', 'GVT']));
        allow write: if sameOrg(orgId) && (admin() || (serviceIs(['GN', 'PN', 'GVT']) && roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher'])));
      }
      match /medicalRecords/{id} {
        allow read: if sameOrg(orgId) && (admin() || serviceIs(['CH']));
        allow write: if sameOrg(orgId) && (admin() || (serviceIs(['CH']) && roleIs(['direction', 'doctor', 'medic'])));
      }
      match /deaths/{id} {
        allow read: if sameOrg(orgId) && (admin() || serviceIs(['CH', 'GVT']));
        allow write: if sameOrg(orgId) && (admin() || (serviceIs(['CH', 'GVT']) && roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher'])));
      }
      match /justiceCases/{id} {
        allow read: if sameOrg(orgId) && (admin() || serviceIs(['GVT']));
        allow write: if sameOrg(orgId) && (admin() || (serviceIs(['GVT']) && roleIs(['direction', 'magistrate', 'greffe'])));
      }
      match /prisonTransfers/{id} {
        allow read: if sameOrg(orgId) && (admin() || serviceIs(['GVT']));
        allow write: if sameOrg(orgId) && (admin() || (serviceIs(['GVT']) && roleIs(['direction', 'magistrate', 'greffe'])));
      }
      match /civilDocuments/{id} {
        allow read: if sameOrg(orgId) && (admin() || serviceIs(['GVT']));
        allow write: if sameOrg(orgId) && (admin() || serviceIs(['GVT']));
      }
      match /weaponPermits/{id} {
        allow read: if sameOrg(orgId) && (admin() || serviceIs(['CH', 'GN', 'PN', 'GVT']));
        allow write: if sameOrg(orgId) && (admin() || (serviceIs(['CH', 'GN', 'PN', 'GVT']) && roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher'])));
      }
      match /cases/{id} {
        allow read: if sameOrg(orgId) && (admin() || (serviceIs(['GN', 'PN', 'GVT']) && resource.data.service == profile().service));
        allow write: if sameOrg(orgId) && (admin() || (serviceIs(['GN', 'PN', 'GVT']) && roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']) && (resource == null || resource.data.service == profile().service) && request.resource.data.service == profile().service));
      }
      match /transmissions/{id} {
        allow read: if sameOrg(orgId) && (admin() || profile().service in resource.data.participants);
        allow write: if sameOrg(orgId) && (admin() || (roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']) && (resource == null || profile().service in resource.data.participants) && (profile().service in request.resource.data.participants)));
      }
      match /staff/{id} {
        allow read: if sameOrg(orgId) && (admin() || resource.data.service == profile().service);
        allow write: if sameOrg(orgId) && (admin() || roleIs(['direction']));
      }
      match /audit/{id} {
        allow read: if sameOrg(orgId) && (admin() || roleIs(['direction']));
        allow create: if sameOrg(orgId) && request.resource.data.service == profile().service;
        allow update, delete: if false;
      }
      match /emergencyCalls/{id} {
        allow read: if sameOrg(orgId);
        allow write: if sameOrg(orgId) && (admin() || roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']));
      }
      match /interventions/{id} {
        allow read: if sameOrg(orgId);
        allow write: if sameOrg(orgId) && (admin() || roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']));
      }
      match /patrols/{id} {
        allow read: if sameOrg(orgId);
        allow write: if sameOrg(orgId) && (admin() || roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']));
      }
      match /tasks/{id} {
        allow read: if sameOrg(orgId);
        allow write: if sameOrg(orgId) && (admin() || roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']));
      }
      match /reports/{id} {
        allow read: if sameOrg(orgId) && (admin() || resource.data.service == profile().service);
        allow write: if sameOrg(orgId) && (admin() || (roleIs(['direction', 'supervisor', 'opj', 'agent', 'doctor', 'medic', 'dispatcher']) && (resource == null || resource.data.service == profile().service) && request.resource.data.service == profile().service));
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (admin() && profile().orgId == resource.data.orgId));
      allow create: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.uid == uid
          && get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerUid == uid)
        || (admin() && request.resource.data.orgId == profile().orgId)
      );
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        || (admin() && request.resource.data.orgId == profile().orgId)
      );
      allow delete: if signedIn() && admin() && resource.data.orgId == profile().orgId && uid != request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
